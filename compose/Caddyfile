# Caddy: TLS termination + reverse proxy for the search and serve stack.
#
# Routes:
#   /mcp*, /health  -> kb-mcp:8765    the MCP server. kb-mcp's own bearer middleware
#                                      (retrieval/auth.py) checks the token on /mcp*;
#                                      /health is open, same as it is directly on kb-mcp.
#   /kb/*           -> kb-static:8080 the read-only kb/ file server every citation `url`
#                                      points at. kb-static has no auth of its own (it is
#                                      plain `file_server`), so the same token is required
#                                      here -- enforced by asking kb-mcp, see below.
#
# WHY /kb/* ASKS kb-mcp RATHER THAN MATCHING THE TOKEN ITSELF. This file used to carry a
# __KB_TOKEN_PATTERN__ placeholder that caddy-entrypoint.sh filled in with a regex of
# every token from $KB_TOKENS, baked in at container start. That made the token list a
# second, independent copy of itself: revoking someone in the store left their credential
# reading the entire converted corpus over /kb/* until `caddy` was restarted -- which is
# the outage the revocation work exists to avoid. `forward_auth` sends each /kb/* request's
# headers to kb-mcp's /auth/check, which consults the one live store (retrieval/tokens.py),
# so a revocation takes effect on both routes at once and nothing here needs reloading.
#
# Cost of the change: one extra in-network request per /kb/* fetch. That
# route serves whole converted markdown files to a human clicking a citation, not the MCP
# hot path, so a sub-millisecond hop inside the compose network should not be optimised
# away by re-introducing a stale copy of the token list.
#
# TLS: `tls internal` (Caddy's own local CA) by default. If both TLS_CERT and TLS_KEY are
# set (paths inside the container -- see docker-compose.yml's `kb_tls` bind mount), Caddy
# uses that cert/key pair instead -- the __TLS_DIRECTIVE__ placeholder below is filled in
# by caddy-entrypoint.sh, because a Caddyfile `tls` line's form (bare `internal` vs. two
# file paths) can't be made conditional on whether two env vars are set using `{$VAR}`
# substitution alone. See docs/administration.md, "TLS", for what "each user's machine must
# trust Caddy's root CA once" means in practice, and the client-cert alternative.

{
	auto_https disable_redirects
	admin off

	# What to serve a client that sends no SNI. TLS SNI carries host NAMES only, so a
	# client dialling this host by IP -- which is how stages 1-4 reached the plain-HTTP
	# server -- sends none, and without a default Caddy fails the handshake outright
	# (`tlsv1 alert internal error`, alert 80, "no peer certificate available"): before
	# any HTTP, so before the Host header, KB_PUBLIC_HOST or the bearer token are in the
	# picture. KB_PUBLIC_HOST is the right certificate to name because the site block
	# below already lists it, so `tls internal` already issues one for it.
	default_sni {$KB_PUBLIC_HOST:localhost}
}

{$KB_PUBLIC_HOST:localhost}, localhost, 127.0.0.1 {
	tls __TLS_DIRECTIVE__

	@mcp path /mcp* /health
	handle @mcp {
		reverse_proxy kb-mcp:8765
	}

	handle /kb/* {
		# 204 -> proceed, 401 -> Caddy returns kb-mcp's 401 (with its WWW-Authenticate
		# header) to the client unchanged. `copy_headers` is deliberately absent: nothing
		# downstream needs the identity, since kb-static serves the same files to anyone
		# who gets past this point.
		forward_auth kb-mcp:8765 {
			uri /auth/check
		}

		uri strip_prefix /kb
		reverse_proxy kb-static:8080
	}

	handle {
		# Also what keeps /auth/check off the LAN: it is reachable only from inside the
		# compose network, never through this site.
		respond "not found" 404
	}
}
