# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local configuration. SOURCE_DIR is machine-specific by design.
.env

# The bearer-token store (KB_TOKENS_FILE, default here). Hashes, not secrets, but
# still a per-deployment list of who has access -- never committed. Back it up with
# the deployment's other state, not with the code.
tokens.json
.tokens.json.tmp
compose/tokens/*
!compose/tokens/.gitkeep

# TLS material for the TLS_CERT/TLS_KEY path (scripts/make_tls_cert.sh writes it here).
# A PRIVATE KEY: never committed, per deployment, regenerated rather than shared.
tls/

# macOS
.DS_Store

# A local MCP stdio server config: absolute paths to this checkout and to the
# machine's own uv. Each developer writes their own; the README says how.
.mcp.json

# The MCP probe writes the server call log here.
mcp-probe-server.log
