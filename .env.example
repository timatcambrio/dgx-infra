# Copy to .env and edit. .env is gitignored.

# ---------------------------------------------------------------------------------------
# REQUIRED. The directory holding the source documents.
#
# The sources live OUTSIDE both repos -- not merely gitignored -- so this has no default and
# no command will invent one. The pipeline treats this directory as strictly READ-ONLY: it
# never writes, moves, renames, or deletes anything under it.
#
# Overridable per run with --source-dir PATH.
# ---------------------------------------------------------------------------------------
SOURCE_DIR=/absolute/path/to/your/documents

# ---------------------------------------------------------------------------------------
# The content repo: holds corpus.yaml, kb/ and work/. Defaults to ../dgx-knowledge.
# ---------------------------------------------------------------------------------------
# KB_PATH=../dgx-knowledge

# Conversion intermediates (e.g. LibreOffice .doc -> .docx). Defaults to $KB_PATH/work.
# Gitignored and disposable: deleting it must only ever cost time, never information.
# WORK_DIR=../dgx-knowledge/work

# Model cache. Deliberately project-local rather than the machine-wide ~/.cache/huggingface,
# so the model gate has a well-defined directory to scan and models belonging to other work
# cannot fail it. Defaults to $WORK_DIR/models.
# HF_HOME=../dgx-knowledge/work/models

# ---------------------------------------------------------------------------------------
# Triage thresholds. Defaults shown.
#
# Do NOT tune these to change how a sample set classifies. Report the numbers at the
# defaults; if a threshold is genuinely wrong, argue it in the README with evidence.
# ---------------------------------------------------------------------------------------
# MIN_CHARS_PER_PAGE=100      # below this, a page counts as "low"
# MIN_ALPHA_RATIO=0.60        # fraction of chars that are alphanumeric/punctuation/space
# MAX_LOW_PAGE_FRACTION=0.20  # above this fraction of low pages, no longer "clean"

# ---------------------------------------------------------------------------------------
# CSV guardrails. Beyond these, conversion stops and asks rather than emitting a table that
# is useless downstream -- the retrieval shape of a large table is a design decision.
# ---------------------------------------------------------------------------------------
# CSV_MAX_ROWS=300
# CSV_MAX_COLS=12

# ---------------------------------------------------------------------------------------
# PDF conversion engine.
#
# `geometry` (default) reconstructs the document from character geometry with pdfplumber:
# no model, no ML runtime, no network, identical output on every machine.
# `docling` escalates to a layout model -- needs `uv sync --extra pdf` and a decision on the
# layout model's base-weight provenance. Meant to be per document, not a blanket switch.
# ---------------------------------------------------------------------------------------
# PDF_ENGINE=geometry

# PDF text annotations -- "Markup" callouts and sticky notes. These are attached to a page
# rather than printed on it, so no text-layer extraction sees them: on an annotated form they
# are often the only instructions the document carries, and dropping them silently turns a
# tutorial back into a blank form. Rendered in place, in reading order, prefixed so a reader
# can tell an annotation from what the form itself says. Set to false only to isolate their
# effect when comparing engines.
# PDF_ANNOTATIONS=true

# Binding each annotation to the field it describes, using the annotation's own callout line,
# a form field on the same row, or failing both, a printed label on the same row -- the last
# marked as inferred, since a guess that reads like a stated fact is worse than no anchor.
# An annotation that matches none of them is left unbound. Set false to keep the annotations
# but emit them unattributed, at their own position on the page.
# PDF_ANNOTATION_LINKING=true
# PDF_ANNOTATION_LINK_TOLERANCE=6.0  # vertical slack, in points, for "on the same row"

# Geometric extraction tuning. These describe page geometry, not document semantics.
# PDF_HEADING_SIZE_RATIO=1.15      # a line this much larger than body text is a heading
# PDF_MARGIN_FRACTION=0.08         # top/bottom band searched for running headers
# PDF_REPEAT_PAGE_FRACTION=0.5     # a margin line on this share of pages is a header
# PDF_LINE_TOLERANCE=3.0           # points of vertical slop when grouping words into lines
# PDF_SPACE_WIDTH_RATIO=0.10       # gap, in font sizes, below which two words are one word
# PDF_PARAGRAPH_GAP_RATIO=1.6      # vertical gap, in line heights, that starts a paragraph
# PDF_COLUMN_GAP_FRACTION=0.06     # gutter width, as a fraction of page width
# PDF_CELL_GAP_RATIO=1.5           # word gap, in font sizes, that separates table cells
# PDF_MIN_TABLE_ROWS=3             # consecutive aligned lines needed to call it a table
# PDF_COLUMN_ALIGN_TOLERANCE=8.0   # points of horizontal slop between rows of a table

# ---------------------------------------------------------------------------------------
# Docling's OCR engine. OCR is OFF for this entire phase; the engine is pinned anyway so a
# Docling default change cannot pull Chinese-trained weights (RapidOCR wraps Baidu's
# PaddleOCR models) into ingestion silently. Asserted in tests/test_gates.py.
# ---------------------------------------------------------------------------------------
# DOCLING_OCR_ENGINE=easyocr
