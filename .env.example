# Copy to .env and edit. .env is gitignored.

# ------------------------------------------------------------------------------
# REQUIRED. The directory holding the source documents.
#
# The sources live OUTSIDE both repos -- not merely gitignored -- so this has no
# default and no command will invent one. The pipeline treats this directory as
# strictly READ-ONLY: it never writes, moves, renames, or deletes anything under
# it.
#
# Overridable per run with --source-dir PATH.
# ------------------------------------------------------------------------------
SOURCE_DIR=/absolute/path/to/your/documents

# ------------------------------------------------------------------------------
# The content repo: holds corpus.yaml, kb/ and work/. Defaults to
# ../dgx-knowledge.
# ------------------------------------------------------------------------------
# KB_PATH=../dgx-knowledge

# Conversion intermediates (e.g. LibreOffice .doc -> .docx). Defaults to
# $KB_PATH/work. Gitignored and disposable: deleting it must only ever cost
# time, never information.
# WORK_DIR=../dgx-knowledge/work

# Model cache. Deliberately project-local rather than the machine-wide
# ~/.cache/huggingface, so the model gate has a well-defined directory to scan
# and models belonging to other work cannot fail it. Defaults to
# $WORK_DIR/models.
# HF_HOME=../dgx-knowledge/work/models

# ------------------------------------------------------------------------------
# Triage thresholds. Defaults shown.
#
# Do NOT tune these to change how a sample set classifies. Report the numbers at
# the defaults; if a threshold is genuinely wrong, argue it in the README with
# evidence.
# ------------------------------------------------------------------------------
# MIN_CHARS_PER_PAGE=100      # below this, a page counts as "low"
# MIN_ALPHA_RATIO=0.60        # share of chars that are alphanumeric/punct/space
# MAX_LOW_PAGE_FRACTION=0.20  # above this share of low pages, no longer "clean"

# ------------------------------------------------------------------------------
# CSV guardrails. Beyond these, conversion stops and asks rather than emitting a
# table that is useless downstream -- the retrieval shape of a large table is a
# design decision.
# ------------------------------------------------------------------------------
# CSV_MAX_ROWS=300
# CSV_MAX_COLS=15

# ------------------------------------------------------------------------------
# PDF conversion engine.
#
# `geometry` (default) reconstructs the document from character geometry with
# pdfplumber: no model, no ML runtime, no network, identical output on every
# machine. `docling` escalates to a layout model -- needs `uv sync --extra pdf`
# and a decision on the layout model's base-weight provenance. Meant to be per
# document, not a blanket switch.
# ------------------------------------------------------------------------------
# PDF_ENGINE=geometry

# Share of a page's area covered by raster images past which the page is
# reported as mostly picture. Not a classification -- a page can be a third
# diagram and be perfectly fine. It is the threshold for *saying so*, because a
# form supplied as a screenshot with typed callouts beside it has a healthy
# character count and a perfect alpha ratio while the form itself is
# unreachable, and nothing else in the pipeline catches that.
# IMAGE_PAGE_COVERAGE=0.15

# PDF text annotations -- "Markup" callouts and sticky notes. These are attached
# to a page rather than printed on it, so no text-layer extraction sees them: on
# an annotated form they are often the only instructions the document carries,
# and dropping them silently turns a tutorial back into a blank form. Rendered
# in place, in reading order, prefixed so a reader can tell an annotation from
# what the form itself says. Set to false only to isolate their effect when
# comparing engines.
# PDF_ANNOTATIONS=true

# Anchoring each annotation to what the file says it is near. Two kinds, both
# measurements: `points to` when the annotation's own callout line lands on
# something, `beside` when they merely share a row. Neither claims which logical
# field a note is about -- a PDF's ruling is a layout grid, not a map of the
# form's fields, so that call belongs to the reader. An annotation matching
# neither is left unanchored. Set false to keep the annotations but emit them
# unattributed, at their own position on the page.
# PDF_ANNOTATION_LINKING=true

# Text the page draws inside a box -- a flattened callout, which is page text
# rather than an annotation object. On by default because the alternative is
# worse than losing the marking: boxes that share a baseline merge into one
# interleaved line, so the text ends up not merely unlabelled but unreadable.
# Rectangles overlapping a ruled table are never treated as notes.
# PDF_BOXED_TEXT=true
# PDF_BOXED_MAX_AREA=0.25            # bigger than this is a border, not a note
# PDF_ANNOTATION_LINK_TOLERANCE=6.0  # vertical slack, in points, for a row

# Geometric extraction tuning. These describe page geometry, not document
# semantics.
# PDF_HEADING_SIZE_RATIO=1.15     # this much larger than body = heading
# PDF_MARGIN_FRACTION=0.08        # band searched for running headers
# PDF_REPEAT_PAGE_FRACTION=0.5    # margin line on this share of pages = header
# PDF_LINE_TOLERANCE=3.0          # vertical slop when grouping words to lines
# PDF_SPACE_WIDTH_RATIO=0.10      # gap in font sizes below which words join
# PDF_PARAGRAPH_GAP_RATIO=1.6     # vertical gap, in lines, starting a paragraph
# PDF_COLUMN_GAP_FRACTION=0.06    # gutter width, as a fraction of page width
# PDF_CELL_GAP_RATIO=1.5          # word gap, in font sizes, splitting cells
# PDF_MIN_TABLE_ROWS=3            # aligned lines needed to call it a table
# PDF_COLUMN_ALIGN_TOLERANCE=8.0  # horizontal slop between rows of a table

# ------------------------------------------------------------------------------
# Docling's OCR engine. OCR is OFF for this entire phase; the engine is pinned
# anyway so a Docling default change cannot pull Chinese-trained weights
# (RapidOCR wraps Baidu's PaddleOCR models) into ingestion silently. Asserted in
# tests/test_gates.py.
# ------------------------------------------------------------------------------
# DOCLING_OCR_ENGINE=easyocr

# ------------------------------------------------------------------------------
# Stage 2: index kb/ into Postgres and serve it over MCP (uv sync --extra serve).
# Everything below is read by `retrieval/config.py`, not by pipeline/.
# ------------------------------------------------------------------------------

# The repo holding kb/ -- same meaning as KB_PATH above; repeated here because
# Stage 2 reads it independently. Defaults to ../dgx-knowledge.
# For the compose stack (`make compose-up`) it must be an ABSOLUTE path: Compose
# resolves a relative bind-mount source against compose/, not the repo root.
# KB_PATH=../dgx-knowledge

# `kb serve`/`kb search` connect with this. SELECT-only role (kb_read). Required
# to run `kb serve`.
# DATABASE_URL=postgresql://kb_read:kb@localhost:5432/kb

# `kb index` connects with this. Owner/writer role (kb_index). Required to run
# `kb index`.
# DATABASE_URL_INDEX=postgresql://kb_index:kb@localhost:5432/kb

# Where ollama serves the embedding model.
# OLLAMA_BASE_URL=http://localhost:11434

# Whether the compose stack reserves this host's NVIDIA GPUs for ollama.
#   auto  (default) use them when this host has them and Docker can pass them through
#   on    require them; `make compose-up` refuses rather than embed on the CPU
#   off   always embed on the CPU
# `make gpu-check` reports which way it goes. Passing GPUs through needs the NVIDIA
# Container Toolkit on the host; auto finds nothing to use without it.
# KB_GPU=auto

# Embedding model and its output dimension. Both are recorded in index_meta at
# `kb index --init` and checked on every later `kb index` run.
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768

# OpenAI-compatible chat endpoint and model for `kb catalog --summarize` (S5
# only, optional, gated on models.yaml).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=granite4:3b

# Where the static kb/ file server is reachable. Required to run `kb serve`:
# every search result's citation url is built from this. No trailing slash
# (config.py strips one if given).
# KB_URL_BASE=https://kb.internal.example/kb

# Host:port `kb serve --transport streamable-http` binds.
# KB_BIND=127.0.0.1:8765

# Hostname allow-listed for MCP's DNS-rebinding protection when serving HTTP.
# KB_PUBLIC_HOST=kb.internal.example

# Comma-separated bearer tokens accepted by the HTTP transport, one per user or
# team. Empty refuses to start `kb serve --transport streamable-http` unless
# --allow-anonymous is passed.
# KB_TOKENS=

# Largest document `fetch` will return whole before falling back to an outline
# plus a "fetch these sections instead" note.
# FETCH_MAX_CHARS=200000

# Chunk sizing, in characters. Do not tune these to chase the eval score; see
# retrieval brief §6.7.
# CHUNK_TARGET=1200
# CHUNK_MAX=2500

# Test database for tests/retrieval/ (compose `dev` profile provides db).
# DATABASE_URL_TEST=postgresql://kb_index:kb@localhost:5432/kb_test

# Compose-only: passwords for the roles the db init script creates. Defaults
# shown are for local dev; the client sets real ones.
# POSTGRES_PASSWORD=postgres
# KB_INDEX_PASSWORD=kb
# KB_READ_PASSWORD=kb

# ------------------------------------------------------------------------------
# Compose-only (`compose/Caddyfile` + `compose/caddy-entrypoint.sh`). Neither key
# is read by any Python code -- retrieval/config.py has no TLS_CERT/TLS_KEY
# field, since only Caddy terminates TLS.
#
# Both unset (the default): Caddy uses `tls internal`, its own local CA. Each
# user's machine then has to trust that CA once -- see the README "TLS"
# section for how to fetch it from the running container.
#
# Both set: paths on the HOST to a client-issued certificate and private key
# (e.g. from an internal CA). docker-compose.yml bind-mounts them into the
# caddy container; caddy-entrypoint.sh uses them instead of `tls internal`.
# Setting only one of the two is an error the entrypoint does not specially
# detect -- Caddy will fail to start with a config error naming the missing
# file.
# ------------------------------------------------------------------------------
# TLS_CERT=/absolute/path/to/fullchain.pem
# TLS_KEY=/absolute/path/to/privkey.pem
