# Copy to .env and edit. .env is gitignored.

# ---------------------------------------------------------------------------------------
# REQUIRED. The directory holding the source documents.
#
# The sources live OUTSIDE both repos -- not merely gitignored -- so this has no default and
# no command will invent one. The pipeline treats this directory as strictly READ-ONLY: it
# never writes, moves, renames, or deletes anything under it.
#
# Overridable per run with --source-dir PATH.
# ---------------------------------------------------------------------------------------
SOURCE_DIR=/absolute/path/to/your/documents

# ---------------------------------------------------------------------------------------
# The content repo: holds corpus.yaml, kb/ and work/. Defaults to ../dgx-knowledge.
# ---------------------------------------------------------------------------------------
# KB_PATH=../dgx-knowledge

# Conversion intermediates (e.g. LibreOffice .doc -> .docx). Defaults to $KB_PATH/work.
# Gitignored and disposable: deleting it must only ever cost time, never information.
# WORK_DIR=../dgx-knowledge/work

# Model cache. Deliberately project-local rather than the machine-wide ~/.cache/huggingface,
# so the model gate has a well-defined directory to scan and models belonging to other work
# cannot fail it. Defaults to $WORK_DIR/models.
# HF_HOME=../dgx-knowledge/work/models

# ---------------------------------------------------------------------------------------
# Triage thresholds. Defaults shown.
#
# Do NOT tune these to change how a sample set classifies. Report the numbers at the
# defaults; if a threshold is genuinely wrong, argue it in the README with evidence.
# ---------------------------------------------------------------------------------------
# MIN_CHARS_PER_PAGE=100      # below this, a page counts as "low"
# MIN_ALPHA_RATIO=0.60        # fraction of chars that are alphanumeric/punctuation/space
# MAX_LOW_PAGE_FRACTION=0.20  # above this fraction of low pages, no longer "clean"

# ---------------------------------------------------------------------------------------
# CSV guardrails. Beyond these, conversion stops and asks rather than emitting a table that
# is useless downstream -- the retrieval shape of a large table is a design decision.
# ---------------------------------------------------------------------------------------
# CSV_MAX_ROWS=300
# CSV_MAX_COLS=12

# ---------------------------------------------------------------------------------------
# Docling's OCR engine. OCR is OFF for this entire phase; the engine is pinned anyway so a
# Docling default change cannot pull Chinese-trained weights (RapidOCR wraps Baidu's
# PaddleOCR models) into ingestion silently. Asserted in tests/test_gates.py.
# ---------------------------------------------------------------------------------------
# DOCLING_OCR_ENGINE=easyocr
